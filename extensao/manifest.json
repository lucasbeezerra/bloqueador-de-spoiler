{
  "manifest_version": 3,
  "name": "Bloqueador de Spoiler",
  "version": "1.10.1",
  "description": "Borra tudo que fala de Vingadores / Marvel para você não pegar spoiler. Clique para revelar.",
  "permissions": ["storage", "activeTab", "alarms", "offscreen"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bloqueador de Spoiler",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["palavras.js", "resumo.js", "content.js"],
      "css": ["estilo.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
